<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>

    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Roboto:wght@300;400;500;700&family=Montserrat:wght@500;600;700&family=Lobster&display=swap"
      rel="stylesheet"
    />
    <style>
      h1, h2, h3 {
        font-family: "Playfair Display", serif;
      }
      p, label, input, span {
        font-family: "Roboto", sans-serif;
      }
      button, a {
        font-family: "Montserrat", sans-serif;
      }

    </style>
    <title>Login - Car Rentals</title>
  </head>
  <body class="bg-gray-50 text-gray-800 antialiased overflow-x-hidden min-h-screen flex flex-col justify-between">
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md shadow-sm transition duration-300">
    </header>

    <main class="py-12 my-auto">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-xl shadow-2xl border border-gray-100 p-8 sm:p-12">
          <div class="text-center mb-8">
            <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Login to Your Account</h1>
            <p class="text-lg text-gray-600">Access your Car Rentals account to manage your bookings and preferences</p>
          </div>

          <form action="/login" method="POST" class="space-y-6">
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#5937E0] focus:border-transparent outline-none transition-all duration-200 text-sm"
                placeholder="Enter your email address"
              />
            </div>

            <div>
              <label for="password" class="block text-sm font-medium text-gray-700 mb-2">Password</label>
              <input
                type="password"
                id="password"
                name="password"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#5937E0] focus:border-transparent outline-none transition-all duration-200 text-sm"
                placeholder="Enter your password"
              />
            </div>

            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <input
                  type="checkbox"
                  id="remember"
                  name="remember"
                  class="h-4 w-4 text-[#5937E0] focus:ring-[#5937E0] border-gray-300 rounded"
                />
                <label for="remember" class="text-sm text-gray-600">Remember me</label>
              </div>
              <a href="/forgot-password" class="text-sm text-[#5937E0] hover:text-[#462ab0] transition-colors">
                Forgot Password?
              </a>
            </div>

            <button
              type="submit"
              class="w-full bg-[#5937E0] hover:bg-[#462ab0] text-white font-bold py-3 px-6 rounded-lg hover:shadow-lg transition duration-200 text-lg"
            >
              Login
            </button>
          </form>

          <div class="mt-8 text-center text-sm text-gray-500">
            <p>
              Don't have an account?
              <a href="/register" class="font-medium text-[#5937E0] hover:text-[#462ab0] transition-colors">
                Register here
              </a>
            </p>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>